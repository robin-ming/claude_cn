[Unit]
Description=Claude CN read-only clipboard bridge daemon
ConditionPathExists=/etc/claude-cn/install.json

[Service]
Type=simple
User=root
RuntimeDirectory=claude-cn-clip
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 -I /usr/lib/claude-cn/service.py clip --socket /run/claude-cn-clip/clip.sock --config /etc/claude-cn/policy.json
Restart=on-failure
RestartSec=2
UMask=0077
# Drops to the authorized user before running the real clipboard tool and reads
# session environments from /proc. CAP_CHOWN hands the socket to the relay user;
# CAP_DAC_READ_SEARCH opens the user's 0400 /proc environ files; CAP_KILL stops
# the dropped-privilege child when its deadline expires.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_SETUID CAP_SETGID CAP_KILL
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# Local desktop sockets only: the daemon must never open a network socket,
# so a forged DISPLAY cannot turn it into an egress channel.
RestrictAddressFamilies=AF_UNIX
KillMode=control-group

[Install]
WantedBy=multi-user.target
